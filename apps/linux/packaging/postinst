#!/bin/sh
# 装完 / 升级后：刷新 IBus 的系统级组件缓存，提示用户重启 IBus 并添加「微明」。
# 不去杀用户会话里的 ibus-daemon：postinst 以 root 跑，碰不到也不该碰用户会话。
set -e

case "$1" in
  configure)
    # 较新的 ibus 包自己有 trigger 做这件事；老版本没有，这里补一次，失败不影响安装
    if command -v ibus >/dev/null 2>&1; then
      ibus write-cache --system >/dev/null 2>&1 || true
    fi
    echo "微明已安装。运行 ibus restart 或注销后，在「设置 → 键盘 → 输入源」里添加「微明」。"
    ;;
esac

exit 0
